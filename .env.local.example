# Personal info — kept OUT of the repo. Copy this file to `.env.local`
# (gitignored) for local dev. For production, paste the filled-in contents
# into Vercel: Project → Settings → Environment Variables → "Import .env"
# (or paste the whole block into the key field — Vercel splits it), then
# Redeploy.
#
# All optional — anything unset falls back to the placeholder persona.

# Site URL — drives canonical links, OG tags, sitemap, and JSON-LD. Set this to
# your live domain (e.g. https://yourname.com or https://your-project.vercel.app).
# Leave blank to fall back to the default. Change the domain? Just update this
# var in Vercel and redeploy — no code edit needed.
NEXT_PUBLIC_SITE_URL=""

NEXT_PUBLIC_OWNER_NAME="Alex Rivera"
NEXT_PUBLIC_OWNER_EMAIL="hello@example.com"
NEXT_PUBLIC_OWNER_LOCATION="The City"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/in/your-handle"
# Your CV, hosted outside the repo (Vercel Blob or a Drive share link).
# When set: "FULL DOSSIER (PDF)" button in About + a Dossier link in Contact.
NEXT_PUBLIC_DOSSIER_URL=""

# Interrogation Room - free key from console.groq.com (no card). Server-side only.
GROQ_API_KEY=""
# Optional model override (default: llama-3.1-8b-instant)
# GROQ_MODEL=""

# OPTIONAL backup provider if Groq is down/exhausted (free: aistudio.google.com/apikey)
GEMINI_API_KEY=""
